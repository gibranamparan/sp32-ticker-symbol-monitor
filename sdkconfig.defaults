# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Increase a bit these stack sizes as they are also a bit too small by default
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# You might have to increase these further if you spawn your own Rust threads
# that allocate large stack variables
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# 4MB flash with the built-in large single-factory-app partition table
# (3MB app). Note: esp-idf-sys does NOT support CONFIG_PARTITION_TABLE_CUSTOM.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Max CPU speed: the TLS handshake's software ECDSA is the slowest step,
# and the Wokwi sim's server-side handshake timeout makes every cycle count
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# RSA-only TLS: the classic ESP32 verifies RSA with the hardware MPI
# accelerator but has NO ECC/ECDSA accelerator, and the Wokwi sim's emulated
# CPU is ~100x slower than real silicon - a software-ECDSA handshake blows
# past the server's ~13 s handshake timeout. Disabling ECDSA client-side
# makes the server serve its RSA chain (coinbase.com <- GTS WR1), verified
# against GTS Root R1 in certs/coinbase-root-ca.pem.
# CONFIG_MBEDTLS_ECDSA_C is not set
# CONFIG_MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA is not set
